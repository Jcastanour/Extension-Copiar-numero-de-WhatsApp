{
  "manifest_version": 3,
  "name": "Copiar número de WhatsApp",
  "version": "1.5.0",
  "description": "Muestra sobre el chat de WhatsApp quién es el cliente, sus días de cobro y sus cuentas de Elixir.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "tabs"],
  "action": {
    "default_icon": "Logo.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "Logo.png",
    "48": "Logo.png",
    "128": "Logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["numero-utils.js", "overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://web.telegram.org/*"],
      "js": ["telegram.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "*://web.telegram.org/*",
    "https://elixircuentas-test.fly.dev/*",
    "https://elixircuentas.com/*",
    "https://codigos.elixircuentas.com/*",
    "http://localhost:8000/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Space"
      }
    },
    "copiar-numero-auto": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copiar número automáticamente en la pestaña activa"
    },
    "abrir-contactos-auto": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Ejecutar content.js (abrir contactos desde WhatsApp)"
    },
    "buscar-elixir-auto": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Buscar número en Elixir Cuentas"
    },
    "copiar-usuario-auto": {
      "description": "Copiar nombre de usuario (@) del chat — asignar tecla en chrome://extensions/shortcuts"
    }
  }
}
